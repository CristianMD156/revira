<svg xmlns="http://www.w3.org/2000/svg" width="390" height="844" viewBox="0 0 390 844">
<rect width="390" height="844" fill="#F5F7F3"/>
<rect x="0" y="0" width="390" height="104" fill="#FFFFFF"/>
<text x="24" y="32" font-family="Arial,sans-serif" font-size="12" fill="#6A756D">REVIRA • PROTÓTIPO</text>
<text x="24" y="64" font-family="Arial,sans-serif" font-size="25" font-weight="700" fill="#173E30">Explorar ofertas</text>
<text x="24" y="87" font-family="Arial,sans-serif" font-size="12" fill="#6A756D">Descubra o que pode ser aproveitado.</text>
<rect x="20" y="122" width="350" height="45" rx="12" fill="#FFFFFF" stroke="#DCE5DD"/><text x="36" y="150" font-family="Arial,sans-serif" font-size="13" font-weight="normal" fill="#7A857D">⌕  Buscar alimento ou categoria</text><rect x="20" y="181" width="78" height="30" rx="15" fill="#DDF3E7" stroke="none"/><text x="34" y="201" font-family="Arial,sans-serif" font-size="12" font-weight="bold" fill="#17845D">Todos</text><rect x="107" y="181" width="103" height="30" rx="14" fill="#FFFFFF" stroke="none"/><text x="118" y="201" font-family="Arial,sans-serif" font-size="11" font-weight="normal" fill="#52645A">Hortifruti</text><rect x="219" y="181" width="91" height="30" rx="14" fill="#FFFFFF" stroke="none"/><text x="230" y="201" font-family="Arial,sans-serif" font-size="11" font-weight="normal" fill="#52645A">Padaria</text><text x="20" y="246" font-family="Arial,sans-serif" font-size="18" font-weight="bold" fill="#173E30">Ofertas disponíveis</text><rect x="20" y="263" width="350" height="105" rx="14" fill="#FFFFFF" stroke="none"/><rect x="30" y="275" width="78" height="80" rx="10" fill="#D8E9D9" stroke="none"/><text x="122" y="292" font-family="Arial,sans-serif" font-size="14" font-weight="bold" fill="#173E30">Caixa de maçãs</text><text x="122" y="314" font-family="Arial,sans-serif" font-size="11" font-weight="normal" fill="#68766D">2 kg • Hortifruti</text><text x="122" y="335" font-family="Arial,sans-serif" font-size="11" font-weight="bold" fill="#B45D2A">Retirada hoje</text><text x="122" y="354" font-family="Arial,sans-serif" font-size="11" font-weight="bold" fill="#17845D">Ver detalhes  →</text><rect x="20" y="383" width="350" height="105" rx="14" fill="#FFFFFF" stroke="none"/><rect x="30" y="395" width="78" height="80" rx="10" fill="#D8E9D9" stroke="none"/><text x="122" y="412" font-family="Arial,sans-serif" font-size="14" font-weight="bold" fill="#173E30">Pães do dia</text><text x="122" y="434" font-family="Arial,sans-serif" font-size="11" font-weight="normal" fill="#68766D">10 unidades • Padaria</text><text x="122" y="455" font-family="Arial,sans-serif" font-size="11" font-weight="bold" fill="#B45D2A">Até 18h</text><text x="122" y="474" font-family="Arial,sans-serif" font-size="11" font-weight="bold" fill="#17845D">Ver detalhes  →</text><rect x="20" y="503" width="350" height="105" rx="14" fill="#FFFFFF" stroke="none"/><rect x="30" y="515" width="78" height="80" rx="10" fill="#D8E9D9" stroke="none"/><text x="122" y="532" font-family="Arial,sans-serif" font-size="14" font-weight="bold" fill="#173E30">Legumes variados</text><text x="122" y="554" font-family="Arial,sans-serif" font-size="11" font-weight="normal" fill="#68766D">1,5 kg • Hortifruti</text><text x="122" y="575" font-family="Arial,sans-serif" font-size="11" font-weight="bold" fill="#B45D2A">Amanhã</text><text x="122" y="594" font-family="Arial,sans-serif" font-size="11" font-weight="bold" fill="#17845D">Ver detalhes  →</text><text x="20" y="641" font-family="Arial,sans-serif" font-size="10" font-weight="normal" fill="#68766D">As ofertas exibidas são dados de demonstração.</text>
<rect x="0" y="756" width="390" height="88" fill="#FFFFFF"/>
<line x1="0" y1="756" x2="390" y2="756" stroke="#E2E8E1"/>
<text x="39" y="786" font-size="20" text-anchor="middle" fill="#718078">⌂</text><text x="39" y="808" font-size="10" text-anchor="middle" fill="#718078">Início</text><text x="117" y="786" font-size="20" text-anchor="middle" fill="#17845D">⌕</text><text x="117" y="808" font-size="10" text-anchor="middle" fill="#17845D">Explorar</text><text x="195" y="786" font-size="20" text-anchor="middle" fill="#718078">+</text><text x="195" y="808" font-size="10" text-anchor="middle" fill="#718078">Ofertar</text><text x="273" y="786" font-size="20" text-anchor="middle" fill="#718078">♡</text><text x="273" y="808" font-size="10" text-anchor="middle" fill="#718078">Reservas</text><text x="351" y="786" font-size="20" text-anchor="middle" fill="#718078">i</text><text x="351" y="808" font-size="10" text-anchor="middle" fill="#718078">Sobre</text>
</svg>