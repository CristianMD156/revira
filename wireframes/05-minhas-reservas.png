<svg xmlns="http://www.w3.org/2000/svg" width="390" height="844" viewBox="0 0 390 844">
<rect width="390" height="844" fill="#F5F7F3"/>
<rect x="0" y="0" width="390" height="104" fill="#FFFFFF"/>
<text x="24" y="32" font-family="Arial,sans-serif" font-size="12" fill="#6A756D">REVIRA • PROTÓTIPO</text>
<text x="24" y="64" font-family="Arial,sans-serif" font-size="25" font-weight="700" fill="#173E30">Minhas reservas</text>
<text x="24" y="87" font-family="Arial,sans-serif" font-size="12" fill="#6A756D">Consulte o status dos seus pedidos.</text>
<text x="20" y="137" font-family="Arial,sans-serif" font-size="13" font-weight="normal" fill="#68766D">Acompanhe suas solicitações.</text><rect x="20" y="164" width="350" height="108" rx="14" fill="#FFFFFF" stroke="none"/><text x="36" y="193" font-family="Arial,sans-serif" font-size="15" font-weight="bold" fill="#173E30">Caixa de maçãs</text><text x="36" y="216" font-family="Arial,sans-serif" font-size="12" font-weight="normal" fill="#68766D">Reserva • 2 kg</text><rect x="36" y="229" width="178" height="26" rx="12" fill="#DDF3E7" stroke="none"/><text x="47" y="247" font-family="Arial,sans-serif" font-size="11" font-weight="bold" fill="#17845D">Aguardando retirada</text><rect x="20" y="292" width="350" height="108" rx="14" fill="#FFFFFF" stroke="none"/><text x="36" y="321" font-family="Arial,sans-serif" font-size="15" font-weight="bold" fill="#173E30">Pães do dia</text><text x="36" y="344" font-family="Arial,sans-serif" font-size="12" font-weight="normal" fill="#68766D">Reserva • 10 unidades</text><rect x="36" y="357" width="178" height="26" rx="12" fill="#DDF3E7" stroke="none"/><text x="47" y="375" font-family="Arial,sans-serif" font-size="11" font-weight="bold" fill="#17845D">Confirmada</text><rect x="20" y="420" width="350" height="108" rx="14" fill="#FFFFFF" stroke="none"/><text x="36" y="449" font-family="Arial,sans-serif" font-size="15" font-weight="bold" fill="#173E30">Legumes variados</text><text x="36" y="472" font-family="Arial,sans-serif" font-size="12" font-weight="normal" fill="#68766D">Reserva • 1,5 kg</text><rect x="36" y="485" width="178" height="26" rx="12" fill="#FBE9E5" stroke="none"/><text x="47" y="503" font-family="Arial,sans-serif" font-size="11" font-weight="bold" fill="#A14D3A">Cancelada</text><text x="20" y="578" font-family="Arial,sans-serif" font-size="14" font-weight="bold" fill="#173E30">Observação</text><text x="20" y="603" font-family="Arial,sans-serif" font-size="12" font-weight="normal" fill="#68766D">Nesta versão, reservas ficam salvas apenas</text><text x="20" y="622" font-family="Arial,sans-serif" font-size="12" font-weight="normal" fill="#68766D">neste dispositivo e não notificam o ofertante.</text>
<rect x="0" y="756" width="390" height="88" fill="#FFFFFF"/>
<line x1="0" y1="756" x2="390" y2="756" stroke="#E2E8E1"/>
<text x="39" y="786" font-size="20" text-anchor="middle" fill="#718078">⌂</text><text x="39" y="808" font-size="10" text-anchor="middle" fill="#718078">Início</text><text x="117" y="786" font-size="20" text-anchor="middle" fill="#718078">⌕</text><text x="117" y="808" font-size="10" text-anchor="middle" fill="#718078">Explorar</text><text x="195" y="786" font-size="20" text-anchor="middle" fill="#718078">+</text><text x="195" y="808" font-size="10" text-anchor="middle" fill="#718078">Ofertar</text><text x="273" y="786" font-size="20" text-anchor="middle" fill="#17845D">♡</text><text x="273" y="808" font-size="10" text-anchor="middle" fill="#17845D">Reservas</text><text x="351" y="786" font-size="20" text-anchor="middle" fill="#718078">i</text><text x="351" y="808" font-size="10" text-anchor="middle" fill="#718078">Sobre</text>
</svg>