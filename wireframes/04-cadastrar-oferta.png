<svg xmlns="http://www.w3.org/2000/svg" width="390" height="844" viewBox="0 0 390 844">
<rect width="390" height="844" fill="#F5F7F3"/>
<rect x="0" y="0" width="390" height="104" fill="#FFFFFF"/>
<text x="24" y="32" font-family="Arial,sans-serif" font-size="12" fill="#6A756D">REVIRA • PROTÓTIPO</text>
<text x="24" y="64" font-family="Arial,sans-serif" font-size="25" font-weight="700" fill="#173E30">Cadastrar oferta</text>
<text x="24" y="87" font-family="Arial,sans-serif" font-size="12" fill="#6A756D">Compartilhe um excedente com segurança.</text>
<text x="20" y="135" font-family="Arial,sans-serif" font-size="13" font-weight="normal" fill="#68766D">Preencha os dados do alimento.</text><text x="20" y="162" font-family="Arial,sans-serif" font-size="12" font-weight="bold" fill="#416454">Nome do alimento</text><rect x="20" y="172" width="350" height="44" rx="10" fill="#FFFFFF" stroke="#DCE5DD"/><text x="33" y="199" font-family="Arial,sans-serif" font-size="12" font-weight="normal" fill="#7A857D">Ex.: caixa de maçãs</text><text x="20" y="242" font-family="Arial,sans-serif" font-size="12" font-weight="bold" fill="#416454">Categoria</text><rect x="20" y="252" width="350" height="44" rx="10" fill="#FFFFFF" stroke="#DCE5DD"/><text x="33" y="279" font-family="Arial,sans-serif" font-size="12" font-weight="normal" fill="#7A857D">Selecione uma categoria</text><text x="20" y="322" font-family="Arial,sans-serif" font-size="12" font-weight="bold" fill="#416454">Quantidade e unidade</text><rect x="20" y="332" width="350" height="44" rx="10" fill="#FFFFFF" stroke="#DCE5DD"/><text x="33" y="359" font-family="Arial,sans-serif" font-size="12" font-weight="normal" fill="#7A857D">Ex.: 2 kg</text><text x="20" y="402" font-family="Arial,sans-serif" font-size="12" font-weight="bold" fill="#416454">Data de validade</text><rect x="20" y="412" width="350" height="44" rx="10" fill="#FFFFFF" stroke="#DCE5DD"/><text x="33" y="439" font-family="Arial,sans-serif" font-size="12" font-weight="normal" fill="#7A857D">DD/MM/AAAA</text><text x="20" y="482" font-family="Arial,sans-serif" font-size="12" font-weight="bold" fill="#416454">Prazo para retirada</text><rect x="20" y="492" width="350" height="44" rx="10" fill="#FFFFFF" stroke="#DCE5DD"/><text x="33" y="519" font-family="Arial,sans-serif" font-size="12" font-weight="normal" fill="#7A857D">Data e horário</text><text x="20" y="562" font-family="Arial,sans-serif" font-size="12" font-weight="bold" fill="#416454">Instruções e conservação</text><rect x="20" y="572" width="350" height="44" rx="10" fill="#FFFFFF" stroke="#DCE5DD"/><text x="33" y="599" font-family="Arial,sans-serif" font-size="12" font-weight="normal" fill="#7A857D">Como retirar e conservar</text><rect x="20" y="652" width="350" height="46" rx="12" fill="#17845D" stroke="none"/><text x="117" y="681" font-family="Arial,sans-serif" font-size="15" font-weight="bold" fill="#FFFFFF">Publicar oferta</text>
<rect x="0" y="756" width="390" height="88" fill="#FFFFFF"/>
<line x1="0" y1="756" x2="390" y2="756" stroke="#E2E8E1"/>
<text x="39" y="786" font-size="20" text-anchor="middle" fill="#718078">⌂</text><text x="39" y="808" font-size="10" text-anchor="middle" fill="#718078">Início</text><text x="117" y="786" font-size="20" text-anchor="middle" fill="#718078">⌕</text><text x="117" y="808" font-size="10" text-anchor="middle" fill="#718078">Explorar</text><text x="195" y="786" font-size="20" text-anchor="middle" fill="#17845D">+</text><text x="195" y="808" font-size="10" text-anchor="middle" fill="#17845D">Ofertar</text><text x="273" y="786" font-size="20" text-anchor="middle" fill="#718078">♡</text><text x="273" y="808" font-size="10" text-anchor="middle" fill="#718078">Reservas</text><text x="351" y="786" font-size="20" text-anchor="middle" fill="#718078">i</text><text x="351" y="808" font-size="10" text-anchor="middle" fill="#718078">Sobre</text>
</svg>